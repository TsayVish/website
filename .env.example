# Copy to .env.local for local development. Use the PUBLISHABLE (anon) key, never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Your live address, used for share links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://tsayvish.com
# AI Studio (server only, never NEXT_PUBLIC_): an API key from fal.ai → Dashboard → Keys.
FAL_KEY=
