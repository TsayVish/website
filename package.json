{
  "name": "tsayvish-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/unit/resolve-ts.mjs --test \"tests/unit/*.test.ts\"",
    "test:db": "bash scripts/test-db.sh",
    "db:schema": "node scripts/build-schema.mjs",
    "db:check": "node scripts/build-schema.mjs --check",
    "check": "npm run typecheck && npm test && npm run db:check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
